# =============================================================
# KOGNAI ENVIRONMENT VARIABLES — v2026.3.7
# =============================================================
# Copy this file to .env and fill in your values.
# Run the preflight check: npx ts-node scripts/scs001/validate-production-preflight.ts
# Phase 1 REQUIRED vars are marked with [REQUIRED P1]
# =============================================================

# --- Anthropic API ---
# Required for CEO + Supervisor agents (Claude Sonnet/Opus)
ANTHROPIC_API_KEY=your-anthropic-api-key

# --- OpenClaw v2026.3.7 ---
OPENCLAW_VERSION=2026.3.7
OPENCLAW_HOOKS_DEFAULT_SESSION_KEY=agent-orchestrator
OPENCLAW_HOOKS_ALLOW_REQUEST_SESSION_KEY=false
OPENCLAW_SANDBOX_SKILLS_ENABLED=true
OPENCLAW_SESSION_ISOLATION=true
OPENCLAW_ENABLE_SSRF_PROTECTION=true
OPENCLAW_ENABLE_PATH_VALIDATION=true

# --- Telegram (notification bridge) ---
# Sprint 091: Telegram notification bridge for pipeline alerts
# Obtain bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id

# --- Ollama (local inference — Mac Mini M4 vault) ---
# Local models: qwen3:0.6b/4b/14b, deepseek-r1:14b — $0.00 cost
OLLAMA_HOST=http://127.0.0.1:11434

# --- MiniMax API (swarm coder/supervisor) ---
MINIMAX_API_KEY=your-minimax-api-key
MINIMAX_GROUP_ID=your-minimax-group-id
MINIMAX_DEFAULT_MODEL=minimax-m2.5
MINIMAX_FAST_MODEL=minimax-m2.5-lightning

# --- Supabase (shared Kognai + Invoica) ---            [REQUIRED P1]
# From: Supabase Dashboard > Settings > API
SUPABASE_URL=your-supabase-project-url
SUPABASE_ANON_KEY=your-supabase-anon-key
# service_role key — needed for VideoHostingService (video upload to scs001-videos bucket)
SUPABASE_SERVICE_KEY=your-supabase-service-role-key   # [REQUIRED P1]

# --- TikTok Content Posting API ---                    [REQUIRED P1]
# From: TikTok Developer Portal > Manage Apps > Access Token (video.upload scope)
TIKTOK_ACCESS_TOKEN=your-tiktok-access-token           # [REQUIRED P1]
TIKTOK_USER_OPENID=your-tiktok-user-openid

# --- SCS-001 Pipeline Mode ---
# SCS_MODE: mock (dry-run, no real posts) | live (real TikTok posts)  [REQUIRED P1 for live]
SCS_MODE=mock
# SCS_EDITING_MODE: mock (solid-color videos) | production (drawtext + subtitle burn-in)
SCS_EDITING_MODE=mock

# --- Media & Content APIs (Phase 1 content pipeline) ---
# YouTube Data API v3 — free at console.cloud.google.com/apis/credentials
# Enable "YouTube Data API v3" → create API key → 10,000 units/day free
# Used by: TrendAgent (live mode) + DiscoveryAgent (real video search)
YOUTUBE_API_KEY=your-youtube-data-api-v3-key                # [REQUIRED P1 for real trends]
# Pexels: https://www.pexels.com/api/ — free tier available
PEXELS_API_KEY=your-pexels-api-key
# Pixabay: https://pixabay.com/api/docs/ — free tier available
PIXABAY_API_KEY=your-pixabay-api-key
# fal.ai (image/video generation — Phase 2+)
FAL_KEY=your-fal-ai-key

# --- Stripe (subscriptions — Phase 1 revenue) ---
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

# --- PostgreSQL (shared Kognai + Invoica) ---
DATABASE_URL=postgresql://agent:password@localhost:5432/kognai

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- FFmpeg ---
# Default: /opt/homebrew/bin/ffmpeg (brew install ffmpeg)
# FFMPEG_PATH=/opt/homebrew/bin/ffmpeg

# --- Supervisor (Mac Mini M4 vault dashboard) ---
SUPERVISOR_URL=http://localhost:3000
SUPERVISOR_API_KEY=your-supervisor-api-key

# --- Achiri HTTP Bridge (Sprint 130/131) ---
# Telegram bot routes /achiri commands to this URL via HTTP POST /chat
# Dev: http://localhost:3420  |  Hetzner prod: http://65.108.90.178/achiri
ACHIRI_BASE_URL=http://localhost:3420
# Alpha access gate (Sprint 131): set ACHIRI_ALPHA_ONLY=true + whitelist chatIds for Apr 25 alpha
ACHIRI_ALPHA_ONLY=false
ACHIRI_ALPHA_WHITELIST=

# --- Tailscale (VPN bridge to Hetzner VPS) ---
# TAILSCALE_IP=100.x.x.x
