{
  "name": "@godman-protocols/sdk",
  "version": "0.2.0",
  "description": "Unified SDK for all 7 Godman Protocols — PACT, LAX, SCORE, SIGNAL, SOUL, AMF, DRS",
  "type": "module",
  "main": "dist/index.js",
  "exports": "./dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "test": "npx tsx smoke.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "agent",
    "protocol",
    "coordination",
    "trust",
    "multi-agent",
    "x402",
    "godman-protocols",
    "sdk"
  ],
  "author": "skingem1",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/godman-protocols/sdk.git"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@godman-protocols/pact": "^0.2.0",
    "@godman-protocols/lax": "^0.2.0",
    "@godman-protocols/score": "^0.2.0",
    "@godman-protocols/signal": "^0.2.0",
    "@godman-protocols/soul": "^0.2.0",
    "@godman-protocols/amf": "^0.2.0",
    "@godman-protocols/drs": "^0.2.0"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "tsx": "^4.7.0"
  }
}
