{
  "name": "tiktok-briefs",
  "version": "0.1.0",
  "description": "Kognai TikTok brief generator — Claude-powered content briefs from IA items",
  "type": "module",
  "scripts": {
    "run": "tsx src/brief-runner.ts",
    "test": "tsx src/brief-runner.ts --dry-run",
    "topic": "tsx src/brief-runner.ts --topic=",
    "briefs:pexels": "tsx src/source-brief-runner.ts --pexels",
    "briefs:pixabay": "tsx src/source-brief-runner.ts --pixabay",
    "briefs:sources": "tsx src/source-brief-runner.ts",
    "briefs:sources:test": "tsx src/source-brief-runner.ts --dry-run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.20.0",
    "@supabase/supabase-js": "^2.0.0",
    "dotenv": "^16.0.0",
    "tsx": "^4.0.0"
  }
}
