{
  "name": "clip-maker",
  "version": "0.1.0",
  "description": "Kognai clip maker — downloads IA videos, extracts vertical TikTok clips via ffmpeg",
  "type": "module",
  "scripts": {
    "run": "tsx src/clip-runner.ts",
    "test": "tsx src/clip-runner.ts --draft --dry-run",
    "draft": "tsx src/clip-runner.ts --draft",
    "overlay": "tsx src/overlay-runner.ts --draft",
    "overlay:test": "tsx src/overlay-runner.ts --draft --dry-run",
    "run:overlay": "tsx src/overlay-runner.ts --approved",
    "compose": "tsx src/compose-runner.ts --draft",
    "compose:test": "tsx src/compose-runner.ts --draft --dry-run",
    "run:compose": "tsx src/compose-runner.ts --approved"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@supabase/supabase-js": "^2.0.0",
    "dotenv": "^16.0.0",
    "ffmpeg-static": "^5.2.0",
    "fluent-ffmpeg": "^2.1.3",
    "tsx": "^4.0.0"
  },
  "devDependencies": {
    "@types/fluent-ffmpeg": "^2.1.21"
  }
}
