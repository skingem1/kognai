      "step_id": "s2",
      "title": "Step 2: Fetch Data",
      "code_lines": [
        "url = f\"https://api.coingecko.com/api/v3/simple/price?ids={coin}&vs_currencies=usd\"",
        "response = requests.get(url).json()",
        "current_price = response[coin][\"usd\"]"
      ],
      "language": "python",
      "explanation": "We fetch the current price of the coin using the CoinGecko API.",
      "duration_s": 8,
      "highlight_lines": [
        1,
        2
      ]
    },
    {
      "step_id": "s3",
      "title": "Step 3: Check Alert",
      "code_lines": [
        "if current_price >= target_price:",
        "    print(f\"Alert: {coin} has reached or exceeded ${target_price} (${current_price})\")",
        "else:",
        "    print(f\"{coin} is below target: ${current_price}\")"
      ],
      "language": "python",
      "explanation": "We compare the current price to the target and print an alert if it's met.",
      "duration_s": 8,
      "highlight_lines": [
        1,
        3
      ]
    },
