{
  "script": {
    "version": "1.0",
    "id": "soul-constitutional-engine",
    "title": "SOUL — Constitutional AI Engine",
    "description": "Demonstrates the SOUL protocol: creating a signed constitution for an AI agent, evaluating actions against allow/deny rules, triggering kill switches, and auditing decisions. The safety primitive for autonomous agents.",
    "scenes": [
      {
        "type": "clear"
      },
      {
        "type": "comment",
        "text": "Scene 1: Import SOUL and create a constitution"
      },
      {
        "type": "output",
        "text": "$ node --input-type=module",
        "caption": "SOUL Protocol — constitutional engine demo"
      },
      {
        "type": "pause",
        "durationMs": 600
      },
      {
        "type": "type",
        "text": "import { createConstitution, signConstitution, evaluateAction } from '@godman-protocols/soul';",
        "keystrokeDelayMs": 25,
        "caption": "Import SOUL from npm"
      },
      {
        "type": "pause",
        "durationMs": 800
      },
      {
        "type": "clear"
      },
      {
        "type": "comment",
        "text": "Scene 2: Define constitutional rules"
      },
      {
        "type": "output",
        "text": "// Step 1: Create a constitution — rules that govern agent behavior",
        "caption": "Define the agent's constitution"
      },
      {
        "type": "pause",
        "durationMs": 500
      },
      {
        "type": "type",
        "text": "const constitution = createConstitution({",
        "keystrokeDelayMs": 40
      },
      {
        "type": "type",
        "text": "  agentId: 'kognai-publishing-agent',",
        "keystrokeDelayMs": 35
      },
      {
        "type": "type",
        "text": "  version: '1.0',",
        "keystrokeDelayMs": 40
      },
      {
        "type": "type",
        "text": "  rules: [",
        "keystrokeDelayMs": 40
      },
      {
        "type": "type",
        "text": "    { id: 'r1', effect: 'allow', action: 'publish:tiktok', condition: 'approved==true' },",
        "keystrokeDelayMs": 25
      },
      {
        "type": "type",
        "text": "    { id: 'r2', effect: 'deny',  action: 'delete:all',   condition: 'always' },",
        "keystrokeDelayMs": 25
      },
      {
        "type": "type",
        "text": "    { id: 'r3', effect: 'deny',  action: 'spend:>1000',  condition: 'always' }",
        "keystrokeDelayMs": 25
      },
      {
        "type": "type",
        "text": "  ]",
        "keystrokeDelayMs": 40
      },
      {
        "type": "type",
        "text": "});",
        "keystrokeDelayMs": 40
      },
      {
        "type": "pause",
        "durationMs": 1000
      },
      {
        "type": "output",
        "text": "",
        "caption": "Constitution created — 3 rules defined"
      },
      {
        "type": "output",
        "text": "constitution.id      → const_7f2a3b4c..."
      },
      {
        "type": "output",
        "text": "constitution.rules   → 3 (1 allow, 2 deny)"
      },
      {
        "type": "output",
        "text": "constitution.status  → unsigned"
      },
      {
        "type": "pause",
        "durationMs": 1200
      },
      {
        "type": "clear"
      },
      {
        "type": "comment",
        "text": "Scene 3: Sign the constitution"
      },
      {
        "type": "output",
        "text": "// Step 2: Sign the constitution — immutable after signing",
        "caption": "Sign constitution — tamper-proof"
      },
      {
        "type": "pause",
        "durationMs": 500
      },
      {
        "type": "type",
        "text": "const signed = signConstitution(constitution, '0xOwnerAddress');",
        "keystrokeDelayMs": 35
      },
      {
        "type": "pause",
        "durationMs": 900
      },
      {
        "type": "output",
        "text": "",
        "caption": "Constitution locked with HMAC-SHA256"
      },
      {
        "type": "output",
        "text": "signed.status    → active"
      },
      {
        "type": "output",
        "text": "signed.signature → 0x8e9f0a1b..."
      },
      {
        "type": "output",
        "text": "signed.signedAt  → 2026-04-14T09:00:00Z"
      },
      {
        "type": "pause",
        "durationMs": 1200
      },
      {
        "type": "clear"
      },
      {
        "type": "comment",
        "text": "Scene 4: Evaluate actions — allow vs deny"
      },
      {
        "type": "output",
        "text": "// Step 3: Evaluate agent actions against constitution",
        "caption": "Evaluate actions in real-time"
      },
      {
        "type": "pause",
        "durationMs": 500
      },
      {
        "type": "type",
        "text": "// Action A: post approved content to TikTok",
        "keystrokeDelayMs": 35
      },
      {
        "type": "pause",
        "durationMs": 600
      },
      {
        "type": "output",
        "text": "evaluateAction(constitution, 'publish:tiktok', { approved: true })"
      },
      {
        "type": "pause",
        "durationMs": 700
      },
      {
        "type": "output",
        "text": "→ ALLOW  rule=r1  'publish:tiktok' with approved=true ✓"
      },
      {
        "type": "pause",
        "durationMs": 600
      },
      {
        "type": "type",
        "text": "// Action B: delete all agent data",
        "keystrokeDelayMs": 35
      },
      {
        "type": "pause",
        "durationMs": 600
      },
      {
        "type": "output",
        "text": "evaluateAction(constitution, 'delete:all', {})"
      },
      {
        "type": "pause",
        "durationMs": 700
      },
      {
        "type": "output",
        "text": "→ DENY   rule=r2  'delete:all' is unconditionally blocked ✗"
      },
      {
        "type": "pause",
        "durationMs": 600
      },
      {
        "type": "type",
        "text": "// Action C: spend $1500 USDC",
        "keystrokeDelayMs": 35
      },
      {
        "type": "pause",
        "durationMs": 600
      },
      {
        "type": "output",
        "text": "evaluateAction(constitution, 'spend:1500', {})"
      },
      {
        "type": "pause",
        "durationMs": 700
      },
      {
        "type": "output",
        "text": "→ DENY   rule=r3  spend exceeds $1000 limit ✗"
      },
      {
        "type": "pause",
        "durationMs": 1000
      },
      {
        "type": "output",
        "text": "",
        "caption": "Deny-by-default — unknown actions blocked automatically"
      },
      {
        "type": "pause",
        "durationMs": 1200
      },
      {
        "type": "clear"
      },
      {
        "type": "comment",
        "text": "Scene 5: Kill switch check"
      },
      {
        "type": "output",
        "text": "// Step 4: Kill switches — automatic agent shutdown conditions",
        "caption": "Kill switches protect against runaway agents"
      },
      {
        "type": "pause",
        "durationMs": 500
      },
      {
        "type": "type",
        "text": "import { checkKillSwitches } from '@godman-protocols/soul';",
        "keystrokeDelayMs": 30
      },
      {
        "type": "pause",
        "durationMs": 500
      },
      {
        "type": "type",
        "text": "checkKillSwitches(constitution, {",
        "keystrokeDelayMs": 40
      },
      {
        "type": "type",
        "text": "  memoryUsageMB: 18000,  // under 22GB limit",
        "keystrokeDelayMs": 30
      },
      {
        "type": "type",
        "text": "  dailyOversightHours: 4  // under 6h limit",
        "keystrokeDelayMs": 30
      },
      {
        "type": "type",
        "text": "});",
        "keystrokeDelayMs": 40
      },
      {
        "type": "pause",
        "durationMs": 900
      },
      {
        "type": "output",
        "text": "→ CONTINUE  all kill-switch thresholds nominal"
      },
      {
        "type": "pause",
        "durationMs": 1000
      },
      {
        "type": "type",
        "text": "checkKillSwitches(constitution, { memoryUsageMB: 23000 });",
        "keystrokeDelayMs": 30
      },
      {
        "type": "pause",
        "durationMs": 900
      },
      {
        "type": "output",
        "text": "→ KILL     memoryUsageMB=23000 exceeds threshold 22528"
      },
      {
        "type": "output",
        "text": "   Agent shutdown initiated."
      },
      {
        "type": "pause",
        "durationMs": 1200
      },
      {
        "type": "output",
        "text": "",
        "caption": "SOUL — constitutional safety for every autonomous agent"
      },
      {
        "type": "pause",
        "durationMs": 2000
      }
    ],
    "terminal": {
      "cols": 90,
      "rows": 26,
      "fontSize": 16,
      "theme": "monokai"
    },
    "postProduction": {
      "resolution": "1920x1080",
      "fps": 30,
      "titleCard": {
        "text": "SOUL Protocol — Constitutional AI Engine",
        "durationSec": 3
      },
      "closingCard": {
        "text": "godman-protocols.github.io  |  @invoica_ai",
        "durationSec": 5
      }
    }
  },
