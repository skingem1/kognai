      "step_id": "s2",
      "title": "Step 2: Word Frequency",
      "code_lines": [
        "def summarize(text, ratio=0.3):",
        "    words = word_tokenize(text.lower())",
        "    stop_words = set(stopwords.words('english'))",
        "    freq_table = {}",
        "    for word in words:",
        "        if word in stop_words or not word.isalnum():",
        "            continue",
        "        freq_table[word] = freq_table.get(word, 0) + 1"
      ],
      "language": "python",
      "explanation": "We count word frequencies, ignoring stop words and non-alphanumeric characters.",
      "duration_s": 8,
      "highlight_lines": [
        0,
        1,
        2,
        4,
        5
      ]
    },
    {
      "step_id": "s3",
      "title": "Step 3: Generate Summary",
      "code_lines": [
        "    sentence_scores = {}",
        "    for sentence in sent_tokenize(text):",
        "        for word in word_tokenize(sentence.lower()):",
        "            if word in freq_table:",
        "                sentence_scores[sentence] = sentence_scores.get(sentence, 0) + freq_table[word]",
        "    top_sentences = sorted(sentence_scores, key=sentence_scores.get, reverse=True)[:int(len(sentences)*ratio)]",
        "    return ' '.join(top_sentences)"
      ],
      "language": "python",
      "explanation": "We score sentences based on word frequency and return the top ones for the summary.",
      "duration_s": 8,
