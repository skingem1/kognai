      "title": "Step 3: Game Loop",
      "code_lines": [
        "while running:",
        "    for event in pygame.event.get():",
        "        if event.type == pygame.QUIT:",
        "            running = False"
      ],
      "language": "python",
      "explanation": "This loop keeps the game running and checks for quit events.",
      "duration_s": 7,
      "highlight_lines": [
