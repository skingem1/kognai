      "step_id": "s4",
      "title": "Step 4: Move & Draw",
      "code_lines": [
        "head = [snake[0][0] + dir[0], snake[0][1] + dir[1]]",
        "snake.insert(0, head)",
        "snake.pop()",
        "win.fill((0, 0, 0))",
        "for seg in snake:",
        "    pygame.draw.rect(win, (0, 255, 0), (*seg, 10, 10))"
      ],
      "language": "python",
      "explanation": "The snake moves forward, and we draw it on the screen every frame.",
