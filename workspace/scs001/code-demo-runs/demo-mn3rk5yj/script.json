      ]
    },
    {
      "step_id": "s2",
      "title": "Step 2: Get Guesses",
      "code_lines": [
        "guesses = 0",
        "while guesses < 6:",
        "    guess = input(\"Guess a 5-letter word: \").lower()",
        "    if len(guess) != 5:",
        "        print(\"Must be 5 letters.\")",
        "        continue"
      ],
      "language": "python",
      "explanation": "We take up to 6 guesses, checking if each is 5 letters long and giving feedback.",
      "duration_s": 8,
      "highlight_lines": [
        0,
        1,
        2,
        3,
        4,
        5
      ]
    },
    {
      "step_id": "s3",
      "title": "Step 3: Check and Win",
      "code_lines": [
        "    guesses += 1",
        "    for i in range(5):",
        "        if guess[i] == word[i]:",
        "            print(f\"\\033[92m{guess[i]}\\033[0m\", end=\"\")",
        "        elif guess[i] in word:",
        "            print(f\"\\033[93m{guess[i]}\\033[0m\", end=\"\")",
        "        else:",
        "            print(f\"\\033[97m{guess[i]}\\033[0m\", end=\"\")",
        "    print()",
        "    if guess == word:",
        "        print(\"You won!\")",
        "        break",
        "else:",
        "    print(f\"You lost. The word was {word}.\")"
      ],
      "language": "python",
      "explanation": "Each letter is colored based on its position in the secret word. If you guess it right, you win!",
