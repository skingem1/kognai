      "step_id": "s1",
      "title": "Step 1: Setup",
      "code_lines": [
        "import random",
        "word_list = [\"apple\", \"grape\", \"peach\", \"plum\", \"pear\"]",
        "word = random.choice(word_list)"
      ],
      "language": "python",
      "explanation": "We start by importing random and choosing a secret 5-letter word from the list.",
      "duration_s": 6,
      "highlight_lines": [
        0,
