  "title": "Build a Python Echo Server in 3 Steps",
  "language": "python",
  "total_duration_s": 28,
  "steps": [
    {
      "step_id": "s1",
      "title": "Step 1: Import Libraries",
      "code_lines": [
        "import socket",
        "import threading"
      ],
      "language": "python",
      "explanation": "We need socket for networking and threading to handle multiple clients at once.",
      "duration_s": 6,
      "highlight_lines": [
        1
      ]
    },
    {
      "step_id": "s2",
      "title": "Step 2: Handle Clients",
      "code_lines": [
        "def handle_client(conn, addr):",
        "    print(f\"Connected by {addr}\")",
        "    while True:",
        "        data = conn.recv(1024)",
        "        if not data:",
        "            break",
        "        conn.sendall(data)",
        "    conn.close()"
      ],
      "language": "python",
      "explanation": "This function receives data from a client and sends it back — like an echo server.",
      "duration_s": 8,
      "highlight_lines": [
        1,
        4
      ]
    },
    {
      "step_id": "s3",
      "title": "Step 3: Start the Server",
      "code_lines": [
        "def start_server():",
        "    s = socket.socket()",
        "    s.bind((\"0.0.0.0\", 12345))",
        "    s.listen(5)",
        "    while True:",
        "        conn, addr = s.accept()",
        "        threading.Thread(target=handle_client, args=(conn, addr)).start()"
      ],
      "language": "python",
      "explanation": "The server listens on port 12345 and spawns a new thread for each incoming connection.",
      "duration_s": 8,
      "highlight_lines": [
        1,
        3
      ]
    },
    {
      "step_id": "s4",
      "title": "Step 4: Run the Code",
      "code_lines": [
        "if __name__ == \"__main__\":",
        "    start_server()"
      ],
      "language": "python",
      "explanation": "Finally, we run the server — and it's ready to echo data back to any client.",
      "duration_s": 6,
      "highlight_lines": [
        1
      ]
    }
