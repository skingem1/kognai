{
  "script": {
    "version": "1.0",
    "id": "lax-latency-routing",
    "title": "LAX — Latency-Aware Execution",
    "description": "Demonstrates the LAX protocol: creating a latency budget, registering SLAs, probing execution time, routing tasks to the fastest model, and checking SLA compliance. The performance optimizer for autonomous agent pipelines.",
    "scenes": [
      {
        "type": "clear"
      },
      {
        "type": "comment",
        "text": "Scene 1: Import LAX and create a budget"
      },
      {
        "type": "output",
        "text": "$ node --input-type=module",
        "caption": "LAX Protocol — latency-aware routing demo"
      },
      {
        "type": "pause",
        "durationMs": 600
      },
      {
        "type": "type",
        "text": "import { createBudget, registerSLA, routeTask, createProbe } from '@godman-protocols/lax';",
        "keystrokeDelayMs": 25,
        "caption": "Import LAX from npm"
      },
      {
        "type": "pause",
        "durationMs": 800
      },
      {
        "type": "clear"
      },
      {
        "type": "comment",
        "text": "Scene 2: Create a latency budget"
      },
      {
        "type": "output",
        "text": "// Step 1: Define a latency budget for a task pipeline",
        "caption": "Set latency budget — per-task SLA"
      },
      {
        "type": "pause",
        "durationMs": 500
      },
      {
        "type": "type",
        "text": "const budget = createBudget({",
        "keystrokeDelayMs": 40
      },
      {
        "type": "type",
        "text": "  taskId: 'script-generation',",
        "keystrokeDelayMs": 35
      },
      {
        "type": "type",
        "text": "  maxLatencyMs: 5000,   // 5 second hard limit",
        "keystrokeDelayMs": 30
      },
      {
        "type": "type",
        "text": "  targetLatencyMs: 2000 // 2 second target",
        "keystrokeDelayMs": 30
      },
      {
        "type": "type",
        "text": "});",
        "keystrokeDelayMs": 40
      },
      {
        "type": "pause",
        "durationMs": 900
      },
      {
        "type": "output",
        "text": "",
        "caption": "Budget created with hard + target limits"
      },
      {
        "type": "output",
        "text": "budget.id          → bgt_8a2f3e1c..."
      },
      {
        "type": "output",
        "text": "budget.maxLatency  → 5000ms"
      },
      {
        "type": "output",
        "text": "budget.target      → 2000ms"
      },
      {
        "type": "pause",
        "durationMs": 1200
      },
      {
        "type": "clear"
      },
      {
        "type": "comment",
        "text": "Scene 3: Register models with SLAs"
      },
      {
        "type": "output",
        "text": "// Step 2: Register model SLAs from observed performance",
        "caption": "Register model performance SLAs"
      },
      {
        "type": "pause",
        "durationMs": 500
      },
      {
        "type": "type",
        "text": "registerSLA({ model: 'qwen3:4b',          p50Ms: 800,  p99Ms: 2200, tier: 'T1' });",
        "keystrokeDelayMs": 22
      },
      {
        "type": "pause",
        "durationMs": 400
      },
      {
        "type": "type",
        "text": "registerSLA({ model: 'qwen3:14b',         p50Ms: 2100, p99Ms: 6500, tier: 'T2' });",
        "keystrokeDelayMs": 22
      },
      {
        "type": "pause",
        "durationMs": 400
      },
      {
        "type": "type",
        "text": "registerSLA({ model: 'claude-sonnet-4-6', p50Ms: 1200, p99Ms: 4200, tier: 'T3' });",
        "keystrokeDelayMs": 22
      },
      {
        "type": "pause",
        "durationMs": 800
      },
      {
        "type": "output",
        "text": "",
        "caption": "3 models registered with latency profiles"
      },
      {
        "type": "output",
        "text": "Models: qwen3:4b (T1) | claude-sonnet-4-6 (T3) | qwen3:14b (T2)"
      },
      {
        "type": "pause",
        "durationMs": 1200
      },
      {
        "type": "clear"
      },
      {
        "type": "comment",
        "text": "Scene 4: Route tasks by budget"
      },
      {
        "type": "output",
        "text": "// Step 3: Route tasks — LAX picks the best model for the budget",
        "caption": "Automatic model selection by latency"
      },
      {
        "type": "pause",
        "durationMs": 500
      },
      {
        "type": "type",
        "text": "// Tight budget: 1s limit — picks fastest model",
        "keystrokeDelayMs": 35
      },
      {
        "type": "pause",
        "durationMs": 400
      },
      {
        "type": "type",
        "text": "routeTask({ taskId: 'hook', budget: createBudget({ maxLatencyMs: 1000 }) });",
        "keystrokeDelayMs": 25
      },
      {
        "type": "pause",
        "durationMs": 700
      },
      {
        "type": "output",
        "text": "→ ROUTE  qwen3:4b   (p50=800ms ≤ 1000ms budget) ✓"
      },
      {
        "type": "pause",
        "durationMs": 600
      },
      {
        "type": "type",
        "text": "// Medium budget: 3s — best quality that fits",
        "keystrokeDelayMs": 35
      },
      {
        "type": "pause",
        "durationMs": 400
      },
      {
        "type": "type",
        "text": "routeTask({ taskId: 'script', budget: createBudget({ maxLatencyMs: 3000 }) });",
        "keystrokeDelayMs": 25
      },
      {
        "type": "pause",
        "durationMs": 700
      },
      {
        "type": "output",
        "text": "→ ROUTE  claude-sonnet-4-6  (p50=1200ms, quality=T3) ✓"
      },
      {
        "type": "pause",
        "durationMs": 600
      },
      {
        "type": "type",
        "text": "// No model fits 400ms — graceful fallback",
        "keystrokeDelayMs": 35
      },
      {
        "type": "pause",
        "durationMs": 400
      },
      {
        "type": "type",
        "text": "routeTask({ taskId: 'realtime', budget: createBudget({ maxLatencyMs: 400 }) });",
        "keystrokeDelayMs": 25
      },
      {
        "type": "pause",
        "durationMs": 700
      },
      {
        "type": "output",
        "text": "→ FALLBACK  no model meets 400ms — using qwen3:4b (fastest available)"
      },
      {
        "type": "pause",
        "durationMs": 1200
      },
      {
        "type": "clear"
      },
      {
        "type": "comment",
        "text": "Scene 5: Measure and probe"
      },
      {
        "type": "output",
        "text": "// Step 4: Probe actual execution — measure real latency",
        "caption": "Probe measures live execution time"
      },
      {
        "type": "pause",
        "durationMs": 500
      },
      {
        "type": "type",
        "text": "const probe = createProbe('qwen3:4b');",
        "keystrokeDelayMs": 40
      },
      {
        "type": "pause",
        "durationMs": 400
      },
      {
        "type": "type",
        "text": "probe.start();",
        "keystrokeDelayMs": 50
      },
      {
        "type": "pause",
        "durationMs": 600
      },
      {
        "type": "output",
        "text": "// ... model call executes ..."
      },
      {
        "type": "pause",
        "durationMs": 800
      },
      {
        "type": "type",
        "text": "const result = probe.end({ tokens: 420, success: true });",
        "keystrokeDelayMs": 30
      },
      {
        "type": "pause",
        "durationMs": 700
      },
      {
        "type": "output",
        "text": "",
        "caption": "SLA compliance checked automatically"
      },
      {
        "type": "output",
        "text": "result.latencyMs  → 743ms"
      },
      {
        "type": "output",
        "text": "result.withinSLA  → true  (p50=800ms)"
      },
      {
        "type": "output",
        "text": "result.efficiency → 93%   (743/800 = excellent)"
      },
      {
        "type": "pause",
        "durationMs": 1000
      },
      {
        "type": "output",
        "text": "",
        "caption": "LAX — every agent call at the right speed, every time"
      },
      {
        "type": "pause",
        "durationMs": 2000
      }
    ],
    "terminal": {
      "cols": 90,
      "rows": 26,
      "fontSize": 16,
      "theme": "monokai"
    },
    "postProduction": {
      "resolution": "1920x1080",
      "fps": 30,
      "titleCard": {
        "text": "LAX Protocol — Latency-Aware Execution",
        "durationSec": 3
      },
      "closingCard": {
        "text": "godman-protocols.github.io  |  @invoica_ai",
        "durationSec": 5
      }
    }
  },
  "result": {
