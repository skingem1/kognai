      "step_id": "s2",
      "title": "Step 2: Encrypt & Decrypt Functions",
      "code_lines": [
        "def encrypt_text(text, key):",
        "    encrypted_bytes = text.encode() + key.encode()",
        "    return base64.b64encode(encrypted_bytes).decode()",
        "",
        "def decrypt_text(encrypted_text, key):",
        "    encrypted_bytes = base64.b64decode(encrypted_text)",
        "    return encrypted_bytes[:-len(key)].decode()"
      ],
      "language": "python",
      "explanation": "We define functions to encrypt and decrypt text using a secret key.",
      "duration_s": 10,
