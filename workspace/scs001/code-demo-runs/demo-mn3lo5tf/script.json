        5
      ]
    },
    {
      "step_id": "s2",
      "title": "Step 2: Study Function",
      "code_lines": [
        "def study():",
        "    while True:",
        "        term = random.choice(list(flashcards.keys()))",
        "        print(f\"Term: {term}\")",
        "        input(\"Press Enter to see definition...\")",
        "        print(f\"Definition: {flashcards[term]}\")",
        "        if input(\"Continue? (y/n): \").lower() != 'y':",
        "            break"
      ],
      "language": "python",
      "explanation": "This function randomly picks a term, waits for input, then shows the definition and asks to continue.",
      "duration_s": 8,
      "highlight_lines": [
