      "title": "Step 1: Setup",
      "code_lines": [
        "import random",
        "",
        "flashcards = {",
        "    \"Python\": \"A high-level programming language.\",",
        "    \"AI\": \"Artificial Intelligence.\",",
        "    \"ML\": \"Machine Learning.\"",
        "}"
      ],
      "language": "python",
      "explanation": "We import random and create a dictionary of flashcard terms and definitions.",
      "duration_s": 7,
      "highlight_lines": [
        0,
        2,
