{
  "script": {
    "version": "1.0",
    "id": "pact-mandate-lifecycle",
    "title": "PACT — Agent Mandate Lifecycle",
    "description": "Demonstrates the PACT protocol: creating a signed mandate, executing model calls under budget control, checking remaining allowance, and revoking the mandate. The core primitive for autonomous agent-to-agent payments.",
    "scenes": [
      {
        "type": "clear"
      },
      {
        "type": "comment",
        "text": "Scene 1: Import PACT and create a mandate"
      },
      {
        "type": "output",
        "text": "$ node --input-type=module",
        "caption": "PACT Protocol — mandate lifecycle demo"
      },
      {
        "type": "pause",
        "durationMs": 600
      },
      {
        "type": "type",
        "text": "import { createMandate, hashMandate, verifyMandate } from '@godman-protocols/pact';",
        "keystrokeDelayMs": 30,
        "caption": "Import PACT from npm"
      },
      {
        "type": "pause",
        "durationMs": 800
      },
      {
        "type": "clear"
      },
      {
        "type": "comment",
        "text": "Scene 2: Create a recurring mandate"
      },
      {
        "type": "output",
        "text": "// Step 1: Create a recurring mandate (100 USDC/call, max 50 calls/day)",
        "caption": "Create a recurring mandate"
      },
      {
        "type": "pause",
        "durationMs": 500
      },
      {
        "type": "type",
        "text": "const mandate = createMandate({",
        "keystrokeDelayMs": 40
      },
      {
        "type": "type",
        "text": "  grantor: '0xAgentAlice',",
        "keystrokeDelayMs": 40
      },
      {
        "type": "type",
        "text": "  grantee: '0xModelGateway',",
        "keystrokeDelayMs": 40
      },
      {
        "type": "type",
        "text": "  maxAmountPerCall: 100n,",
        "keystrokeDelayMs": 40
      },
      {
        "type": "type",
        "text": "  maxCallsPerPeriod: 50,",
        "keystrokeDelayMs": 40
      },
      {
        "type": "type",
        "text": "  periodSeconds: 86400,",
        "keystrokeDelayMs": 40
      },
      {
        "type": "type",
        "text": "  modelTier: 'T3'",
        "keystrokeDelayMs": 40
      },
      {
        "type": "type",
        "text": "});",
        "keystrokeDelayMs": 40
      },
      {
        "type": "pause",
        "durationMs": 1000
      },
      {
        "type": "output",
        "text": "",
        "caption": "Mandate signed with EIP-712"
      },
      {
        "type": "output",
        "text": "mandate.id    → 0x4f3a2b1c..."
      },
      {
        "type": "output",
        "text": "mandate.scope → model:T3"
      },
      {
        "type": "output",
        "text": "mandate.limit → 100 USDC × 50 calls/day"
      },
      {
        "type": "output",
        "text": "mandate.sig   → 0x7e8f9a0b... [EIP-712 signed]"
      },
      {
        "type": "pause",
        "durationMs": 1200
      },
      {
        "type": "clear"
      },
      {
        "type": "comment",
        "text": "Scene 3: Hash and verify the mandate"
      },
      {
        "type": "output",
        "text": "// Step 2: Hash and verify — tamper-proof",
        "caption": "Verify mandate integrity"
      },
      {
        "type": "pause",
        "durationMs": 500
      },
      {
        "type": "type",
        "text": "const hash = hashMandate(mandate);",
        "keystrokeDelayMs": 40
      },
      {
        "type": "pause",
        "durationMs": 600
      },
      {
        "type": "type",
        "text": "const valid = verifyMandate(mandate, hash);",
        "keystrokeDelayMs": 40
      },
      {
        "type": "pause",
        "durationMs": 800
      },
      {
        "type": "output",
        "text": "",
        "caption": "Mandate integrity verified"
      },
      {
        "type": "output",
        "text": "hash  → 0x9c4d5e6f..."
      },
      {
        "type": "output",
        "text": "valid → true ✓"
      },
      {
        "type": "pause",
        "durationMs": 1200
      },
      {
        "type": "clear"
      },
      {
        "type": "comment",
        "text": "Scene 4: Execute calls under the mandate"
      },
      {
        "type": "output",
        "text": "// Step 3: Execute model calls — budget tracked automatically",
        "caption": "Calls tracked under mandate budget"
      },
      {
        "type": "pause",
        "durationMs": 500
      },
      {
        "type": "type",
        "text": "// Call 1: claude-sonnet-4-6 (T3) — allowed",
        "keystrokeDelayMs": 35
      },
      {
        "type": "pause",
        "durationMs": 600
      },
      {
        "type": "output",
        "text": "→ ALLOW  claude-sonnet-4-6  cost=85 USDC  calls=1/50"
      },
      {
        "type": "pause",
        "durationMs": 500
      },
      {
        "type": "type",
        "text": "// Call 2: claude-sonnet-4-6 (T3) — allowed",
        "keystrokeDelayMs": 35
      },
      {
        "type": "pause",
        "durationMs": 600
      },
      {
        "type": "output",
        "text": "→ ALLOW  claude-sonnet-4-6  cost=92 USDC  calls=2/50"
      },
      {
        "type": "pause",
        "durationMs": 500
      },
      {
        "type": "type",
        "text": "// Call 3: claude-opus-4-6 (T4) — REJECT (tier exceeded)",
        "keystrokeDelayMs": 35
      },
      {
        "type": "pause",
        "durationMs": 600
      },
      {
        "type": "output",
        "text": "→ REJECT  claude-opus-4-6   T4 exceeds mandate tier T3"
      },
      {
        "type": "pause",
        "durationMs": 1000
      },
      {
        "type": "output",
        "text": "",
        "caption": "Tier enforcement prevents overspend"
      },
      {
        "type": "pause",
        "durationMs": 1200
      },
      {
        "type": "clear"
      },
      {
        "type": "comment",
        "text": "Scene 5: Revoke and verify rejection"
      },
      {
        "type": "output",
        "text": "// Step 4: Revoke the mandate — all future calls blocked",
        "caption": "Revoke mandate — instant kill switch"
      },
      {
        "type": "pause",
        "durationMs": 500
      },
      {
        "type": "type",
        "text": "import { revokeMandate } from '@godman-protocols/pact';",
        "keystrokeDelayMs": 35
      },
      {
        "type": "pause",
        "durationMs": 400
      },
      {
        "type": "type",
        "text": "revokeMandate(mandate.id);",
        "keystrokeDelayMs": 50
      },
      {
        "type": "pause",
        "durationMs": 800
      },
      {
        "type": "output",
        "text": "mandate.revoked → true"
      },
      {
        "type": "pause",
        "durationMs": 500
      },
      {
        "type": "type",
        "text": "// Attempt call after revocation",
        "keystrokeDelayMs": 35
      },
      {
        "type": "pause",
        "durationMs": 600
      },
      {
        "type": "output",
        "text": "→ REJECT  Mandate 0x4f3a... has been revoked"
      },
      {
        "type": "pause",
        "durationMs": 1000
      },
      {
        "type": "output",
        "text": "",
        "caption": "PACT — cryptographic coordination for autonomous agents"
      },
      {
        "type": "pause",
        "durationMs": 2000
      }
    ],
    "terminal": {
      "cols": 90,
      "rows": 26,
      "fontSize": 16,
      "theme": "monokai"
    },
    "postProduction": {
      "resolution": "1920x1080",
      "fps": 30,
