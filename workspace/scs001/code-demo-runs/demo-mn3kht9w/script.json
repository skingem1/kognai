      "title": "Step 1: Setup",
      "code_lines": [
        "import pyautogui",
        "import time",
        "import tkinter as tk",
        "from tkinter import filedialog"
      ],
      "language": "python",
      "explanation": "We import the necessary libraries for taking screenshots and creating a GUI.",
      "duration_s": 6,
