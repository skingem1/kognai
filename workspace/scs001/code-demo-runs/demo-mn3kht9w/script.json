      "step_id": "s2",
      "title": "Step 2: Take Screenshot",
      "code_lines": [
        "def take_screenshot():",
        "    time.sleep(2)",
        "    screenshot = pyautogui.screenshot()",
        "    path = filedialog.asksaveasfilename(defaultextension='.png')",
        "    if path:",
        "        screenshot.save(path)"
      ],
      "language": "python",
      "explanation": "This function waits 2 seconds, takes a screenshot, and saves it to a user-selected location.",
      "duration_s": 8,
      "highlight_lines": [
        0,
        2,
        4
      ]
    },
    {
      "step_id": "s3",
      "title": "Step 3: GUI Setup",
      "code_lines": [
        "root = tk.Tk()",
        "root.title('Screenshot Tool')",
        "btn = tk.Button(root, text='Take Screenshot', command=take_screenshot)",
        "btn.pack()",
        "root.mainloop()"
      ],
      "language": "python",
      "explanation": "We create a simple GUI window with a button to trigger the screenshot function.",
      "duration_s": 8,
