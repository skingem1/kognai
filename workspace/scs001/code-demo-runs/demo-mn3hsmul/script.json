      ]
    },
    {
      "step_id": "s4",
      "title": "Step 4: Export Component",
      "code_lines": [
        "export default TodoApp;"
      ],
      "language": "javascript",
      "explanation": "Finally, we export the TodoApp component so it can be used in other parts of the app.",
