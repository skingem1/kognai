  "steps": [
    {
      "step_id": "s1",
      "title": "Step 1: Setup",
      "code_lines": [
        "import React, { useState } from 'react';",
        "function TodoApp() {",
        "  const [todos, setTodos] = useState([]);",
        "  const [input, setInput] = useState('');"
      ],
      "language": "javascript",
      "explanation": "We start by importing React and useState, then define our component and state variables for todos and input.",
      "duration_s": 6,
      "highlight_lines": [
        0,
        1,
        2,
        3
      ]
    },
    {
      "step_id": "s2",
      "title": "Step 2: Add Todo Function",
      "code_lines": [
        "  const addTodo = () => {",
        "    if (input.trim()) {",
        "      setTodos([...todos, input]);",
        "      setInput('');",
        "    }",
        "}"
      ],
      "language": "javascript",
      "explanation": "This function adds a new todo to the list if the input is not empty, then clears the input field.",
      "duration_s": 7,
      "highlight_lines": [
        0,
        1,
        2,
        3,
        4,
        5
      ]
    },
    {
      "step_id": "s3",
      "title": "Step 3: Render UI",
      "code_lines": [
        "  return (",
        "    <div>",
        "      <input value={input} onChange={(e) => setInput(e.target.value)} />",
        "      <button onClick={addTodo}>Add</button>",
        "      <ul>",
        "        {todos.map((todo, index) => (",
        "          <li key={index}>{todo}</li>",
        "        ))}",
        "      </ul>",
        "    </div>",
        "  );",
        "}"
      ],
      "language": "javascript",
      "explanation": "We render the input field, add button, and list of todos using React's JSX syntax and map function.",
      "duration_s": 8,
      "highlight_lines": [
        0,
        1,
        2,
        3,
        4,
        5,
        6,
