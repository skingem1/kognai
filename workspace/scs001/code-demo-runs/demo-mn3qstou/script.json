      "title": "Step 2: Rate Limit Decorator",
      "code_lines": [
        "def rate_limit(max_requests, window_seconds):",
        "    def decorator(f):",
        "        @wraps(f)",
        "        def wrapper(*args, **kwargs):",
        "            key = f\"{f.__name__}:{args[0].remote_addr}\""
      ],
      "language": "python",
      "explanation": "This decorator tracks user requests and limits them per time window",
      "duration_s": 8,
