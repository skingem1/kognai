      "step_id": "s2",
      "title": "Step 2: Define Function",
      "code_lines": [
        "def format_json(json_str):",
        "    try:",
        "        parsed = json.loads(json_str)",
        "        return json.dumps(parsed, indent=4, sort_keys=True)",
        "    except json.JSONDecodeError:",
        "        return \"Invalid JSON\""
      ],
      "language": "python",
      "explanation": "We define a function that parses and formats JSON with indentation and sorted keys.",
      "duration_s": 8,
      "highlight_lines": [
        0,
        2,
        3
      ]
    },
    {
      "step_id": "s3",
      "title": "Step 3: Run from CLI",
      "code_lines": [
        "if __name__ == \"__main__\":",
        "    import sys",
        "    if len(sys.argv) > 1:",
        "        print(format_json(sys.argv[1]))"
      ],
      "language": "python",
      "explanation": "Finally, we allow the script to run from the command line and process input JSON.",
