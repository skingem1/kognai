      "title": "Step 2: Add One-Time and Repeating Tasks",
      "code_lines": [
        "    def add_task(self, func, delay):",
        "        def wrapper():",
        "            time.sleep(delay)",
        "            func()",
        "        threading.Thread(target=wrapper).start()",
        "",
        "    def add_repeating_task(self, func, interval):",
        "        def wrapper():",
        "            while True:",
        "                func()",
        "                time.sleep(interval)",
        "        threading.Thread(target=wrapper).start()"
      ],
      "language": "python",
      "explanation": "We add two methods: one for one-time tasks and one for repeating tasks using threading and time.sleep.",
