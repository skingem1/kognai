      "title": "Step 1: Setup",
      "code_lines": [
        "import pygame, sys",
        "pygame.init()",
        "screen = pygame.display.set_mode((800, 600))",
        "clock = pygame.time.Clock()",
        "ball = pygame.Rect(400, 300, 20, 20)",
        "paddle1 = pygame.Rect(10, 250, 10, 100)",
        "paddle2 = pygame.Rect(780, 250, 10, 100)",
        "ball_speed = [5, 5]"
      ],
      "language": "python",
      "explanation": "We initialize Pygame, set up the screen, and create the ball and paddles using Rect objects.",
      "duration_s": 8,
      "highlight_lines": [
        0,
        1,
