        7
      ]
    },
    {
      "step_id": "s2",
      "title": "Step 2: Controls and Movement",
      "code_lines": [
        "while True:",
        "    for event in pygame.event.get():",
        "        if event.type == pygame.QUIT:",
        "            pygame.quit()",
        "            sys.exit()",
        "    keys = pygame.key.get_pressed()",
        "    if keys[pygame.K_w]: paddle1.y -= 5",
        "    if keys[pygame.K_s]: paddle1.y += 5",
        "    if keys[pygame.K_UP]: paddle2.y -= 5",
        "    if keys[pygame.K_DOWN]: paddle2.y += 5"
      ],
      "language": "python",
      "explanation": "We handle user input for paddle movement and check for the quit event to close the window.",
      "duration_s": 8,
      "highlight_lines": [
        0,
