      ]
    },
    {
      "step_id": "s3",
      "title": "Step 3: Ball Movement and Collision",
      "code_lines": [
        "    ball.x += ball_speed[0]",
        "    ball.y += ball_speed[1]",
        "    if ball.top <= 0 or ball.bottom >= 600:",
        "        ball_speed[1] *= -1",
        "    if ball.colliderect(paddle1) or ball.colliderect(paddle2):",
        "        ball_speed[0] *= -1",
        "    screen.fill((0, 0, 0))",
        "    pygame.draw.rect(screen, (255, 255, 255), paddle1)",
        "    pygame.draw.rect(screen, (255, 255, 255), paddle2)",
        "    pygame.draw.ellipse(screen, (255, 255, 255), ball)",
        "    pygame.display.flip()",
        "    clock.tick(60)"
      ],
      "language": "python",
      "explanation": "The ball moves and bounces off the top/bottom and paddles. We draw everything and keep the game running at 60 FPS.",
