  "title": "Build a Chatbot in 3 Steps!",
  "language": "python",
  "total_duration_s": 24,
  "steps": [
    {
      "step_id": "s1",
      "title": "Step 1: Setup",
      "code_lines": [
        "import nltk",
        "from nltk.chat.util import Chat, reflections"
      ],
      "language": "python",
      "explanation": "We start by importing the necessary libraries from NLTK.",
      "duration_s": 6,
      "highlight_lines": [
        1
      ]
    },
    {
      "step_id": "s2",
      "title": "Step 2: Define Responses",
      "code_lines": [
        "pairs = [",
        "    [\"hi\", [\"Hello!\", \"Hi there!\", \"How can I help you?\"]],",
        "    [\"how are you\", [\"I'm just a bot, but I'm here to help!\", \"I'm fine, thanks!\"]],",
        "    [\"bye\", [\"Goodbye!\", \"Have a great day!\"]],",
        "]"
      ],
      "language": "python",
      "explanation": "We define a list of possible user inputs and matching responses.",
      "duration_s": 8,
      "highlight_lines": [
        1
      ]
    },
    {
      "step_id": "s3",
      "title": "Step 3: Run the Chatbot",
      "code_lines": [
        "chatbot = Chat(pairs, reflections)",
        "print(\"Chatbot: Hello! Type 'bye' to exit.\")",
        "while True:",
        "    user_input = input(\"You: \")",
        "    if user_input.lower() == \"bye\":",
        "        print(\"Chatbot: Goodbye!\")",
        "        break",
        "    response = chatbot.respond(user_input)",
        "    print(\"Chatbot:\", response)"
      ],
      "language": "python",
      "explanation": "Finally, we create the chatbot and run a loop to respond to user input.",
      "duration_s": 10,
      "highlight_lines": [
        1,
        4
      ]
    }
  ],
