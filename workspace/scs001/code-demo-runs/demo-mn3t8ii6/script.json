      "step_id": "s2",
      "title": "Step 2: Record Audio",
      "code_lines": [
        "filename = 'recording.wav'",
        "recording = []",
        "def record():",
        "    global recording",
        "    recording = sd.rec(int(5 * 44100), samplerate=44100, channels=2)",
        "    sd.wait()"
      ],
      "language": "python",
      "explanation": "We define a function to record audio for 5 seconds at 44.1kHz sample rate.",
      "duration_s": 8,
      "highlight_lines": [
