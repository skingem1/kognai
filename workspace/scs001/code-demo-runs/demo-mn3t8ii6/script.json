        6
      ]
    },
    {
      "step_id": "s3",
      "title": "Step 3: Save and Stop",
      "code_lines": [
        "sf.write(filename, recording, 44100)",
        "threading.Thread(target=record).start()",
        "input('Recording... Press Enter to stop.')"
      ],
      "language": "python",
      "explanation": "We start the recording thread and wait for user input to stop and save the audio file.",
