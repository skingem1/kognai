  "title": "Tic Tac Toe in Python - 30 Seconds",
  "language": "python",
  "total_duration_s": 29,
  "steps": [
    {
      "step_id": "s1",
      "title": "Step 1: Setup",
      "code_lines": [
        "board = [\" \" for _ in range(9)]",
        "def print_board():",
        "    for i in range(3):",
        "        print(\" | \".join(board[i*3:(i+1)*3]))"
      ],
      "language": "python",
      "explanation": "We create a board with 9 empty spaces and a function to print it.",
      "duration_s": 6,
      "highlight_lines": [
        0
      ]
    },
    {
      "step_id": "s2",
      "title": "Step 2: Check for Win",
      "code_lines": [
        "def win(player):",
        "    wins = [[0,1,2],[3,4,5],[6,7,8],[0,3,6],[1,4,7],[2,5,8],[0,4,8],[2,4,6]]",
        "    return any(all(board[i] == player for i in line) for line in wins)"
      ],
      "language": "python",
      "explanation": "This function checks if a player has won by checking all winning lines.",
      "duration_s": 7,
      "highlight_lines": [
        0
      ]
    },
    {
      "step_id": "s3",
      "title": "Step 3: Play the Game",
      "code_lines": [
        "def play():",
        "    current = \"X\"",
        "    while True:",
        "        print_board()",
        "        move = int(input(f\"Player {current}, enter position (0-8): \"))",
        "        if board[move] == \" \":",
        "            board[move] = current",
        "            if win(current):",
        "                print_board()",
        "                print(f\"Player {current} wins!\")",
        "                break",
        "            current = \"O\" if current == \"X\" else \"X\""
      ],
      "language": "python",
      "explanation": "The play function handles turns, checks for valid moves, and ends the game when a player wins.",
      "duration_s": 10,
      "highlight_lines": [
        0,
        4,
        7
      ]
    },
    {
      "step_id": "s4",
      "title": "Step 4: Run the Game",
      "code_lines": [
        "play()"
      ],
      "language": "python",
      "explanation": "Finally, we call the play function to start the game!",
      "duration_s": 6,
      "highlight_lines": [
