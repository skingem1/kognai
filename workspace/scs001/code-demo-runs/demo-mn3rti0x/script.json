      "title": "Step 2: Fetch Page",
      "code_lines": [
        "def download_thumbnail(video_id):",
        "    url = f\"https://www.youtube.com/watch?v={video_id}\"",
        "    res = requests.get(url)"
      ],
      "language": "python",
      "explanation": "We define a function and fetch the YouTube page using the video ID.",
      "duration_s": 7,
      "highlight_lines": [
        1
      ]
    },
    {
      "step_id": "s3",
      "title": "Step 3: Extract Thumbnail",
      "code_lines": [
        "    soup = BeautifulSoup(res.text, 'html.parser')",
        "    thumb = soup.find('meta', property='og:image')['content']"
      ],
      "language": "python",
      "explanation": "We parse the HTML and find the thumbnail URL from the meta tags.",
      "duration_s": 7,
      "highlight_lines": [
        1
      ]
    },
    {
      "step_id": "s4",
      "title": "Step 4: Save Image",
      "code_lines": [
        "    filename = f\"{video_id}.jpg\"",
        "    with open(filename, 'wb') as f:",
        "        f.write(requests.get(thumb).content)"
      ],
      "language": "python",
      "explanation": "We download the thumbnail and save it as a JPG file.",
      "duration_s": 7,
      "highlight_lines": [
        0,
        2
      ]
