{
  "script": {
    "version": "1.0",
    "id": "amf-message-format",
    "title": "AMF — Agent Message Format",
    "description": "Demonstrates the AMF protocol: creating typed message envelopes, signing them with HMAC-SHA256, verifying integrity, and building structured payloads (task, result, error). The universal message format for inter-agent communication.",
    "scenes": [
      {
        "type": "clear"
      },
      {
        "type": "comment",
        "text": "Scene 1: Import AMF and create an envelope"
      },
      {
        "type": "output",
        "text": "$ node --input-type=module",
        "caption": "AMF Protocol — agent message format demo"
      },
      {
        "type": "pause",
        "durationMs": 600
      },
      {
        "type": "type",
        "text": "import { createEnvelope, verifyEnvelope, buildTaskPayload } from '@godman-protocols/amf';",
        "keystrokeDelayMs": 22,
        "caption": "Import AMF from npm"
      },
      {
        "type": "pause",
        "durationMs": 800
      },
      {
        "type": "clear"
      },
      {
        "type": "comment",
        "text": "Scene 2: Create and sign an envelope"
      },
      {
        "type": "output",
        "text": "// Step 1: Wrap a task message in a signed AMF envelope",
        "caption": "Create a signed message envelope"
      },
      {
        "type": "pause",
        "durationMs": 500
      },
      {
        "type": "type",
        "text": "const envelope = createEnvelope({",
        "keystrokeDelayMs": 40
      },
      {
        "type": "type",
        "text": "  from: 'orchestrator-agent',",
        "keystrokeDelayMs": 35
      },
      {
        "type": "type",
        "text": "  to: 'coder-agent',",
        "keystrokeDelayMs": 35
      },
      {
        "type": "type",
        "text": "  type: 'task',",
        "keystrokeDelayMs": 35
      },
      {
        "type": "type",
        "text": "  payload: buildTaskPayload({ description: 'Write auth module', priority: 'high' })",
        "keystrokeDelayMs": 22
      },
      {
        "type": "type",
        "text": "});",
        "keystrokeDelayMs": 40
      },
      {
        "type": "pause",
        "durationMs": 900
      },
      {
        "type": "output",
        "text": "",
        "caption": "Envelope created and signed"
      },
      {
        "type": "output",
        "text": "envelope.id        → amf_3d2c1b0a..."
      },
      {
        "type": "output",
        "text": "envelope.from      → orchestrator-agent"
      },
      {
        "type": "output",
        "text": "envelope.to        → coder-agent"
      },
      {
        "type": "output",
        "text": "envelope.type      → task"
      },
      {
        "type": "output",
        "text": "envelope.signature → 0x5e6f7a8b... [HMAC-SHA256]"
      },
      {
        "type": "output",
        "text": "envelope.timestamp → 2026-04-14T09:00:00.000Z"
      },
      {
        "type": "pause",
        "durationMs": 1200
      },
      {
        "type": "clear"
      },
      {
        "type": "comment",
        "text": "Scene 3: Verify integrity"
      },
      {
        "type": "output",
        "text": "// Step 2: Verify envelope integrity — tamper detection",
        "caption": "Verify message authenticity"
      },
      {
        "type": "pause",
        "durationMs": 500
      },
      {
        "type": "type",
        "text": "const v1 = verifyEnvelope(envelope);  // untampered",
        "keystrokeDelayMs": 35
      },
      {
        "type": "pause",
        "durationMs": 700
      },
      {
        "type": "output",
        "text": "v1.valid → true ✓  signature matches"
      },
      {
        "type": "pause",
        "durationMs": 600
      },
      {
        "type": "type",
        "text": "// Tamper with the payload",
        "keystrokeDelayMs": 40
      },
      {
        "type": "pause",
        "durationMs": 400
      },
      {
        "type": "type",
        "text": "envelope.payload.priority = 'critical';  // injected!",
        "keystrokeDelayMs": 28
      },
      {
        "type": "pause",
        "durationMs": 500
      },
      {
        "type": "type",
        "text": "const v2 = verifyEnvelope(envelope);  // tampered",
        "keystrokeDelayMs": 35
      },
      {
        "type": "pause",
        "durationMs": 700
      },
      {
        "type": "output",
        "text": "v2.valid → false ✗  signature mismatch — tampering detected!"
      },
      {
        "type": "pause",
        "durationMs": 1200
      },
      {
        "type": "clear"
      },
      {
        "type": "comment",
        "text": "Scene 4: Build structured payloads"
      },
      {
        "type": "output",
        "text": "// Step 3: Typed payload builders — task, result, error",
        "caption": "Structured payload helpers"
      },
      {
        "type": "pause",
        "durationMs": 500
      },
      {
        "type": "type",
        "text": "import { buildResultPayload, buildErrorPayload } from '@godman-protocols/amf';",
        "keystrokeDelayMs": 22
      },
      {
        "type": "pause",
        "durationMs": 600
      },
      {
        "type": "type",
        "text": "const result = buildResultPayload({ taskId: 'T-001', output: 'auth.ts written', score: 92 });",
        "keystrokeDelayMs": 20
      },
      {
        "type": "pause",
        "durationMs": 500
      },
      {
        "type": "output",
        "text": "result.type   → 'result'"
      },
      {
        "type": "output",
        "text": "result.taskId → T-001"
      },
      {
        "type": "output",
        "text": "result.score  → 92"
      },
      {
        "type": "pause",
        "durationMs": 600
      },
      {
        "type": "type",
        "text": "const error = buildErrorPayload({ code: 'TIMEOUT', message: 'LLM timed out after 30s' });",
        "keystrokeDelayMs": 20
      },
      {
        "type": "pause",
        "durationMs": 500
      },
      {
        "type": "output",
        "text": "error.type    → 'error'"
      },
      {
        "type": "output",
        "text": "error.code    → TIMEOUT"
      },
      {
        "type": "pause",
        "durationMs": 1000
      },
      {
        "type": "output",
        "text": "",
        "caption": "AMF — every agent message signed, typed, and tamper-proof"
      },
      {
        "type": "pause",
        "durationMs": 2000
      }
    ],
    "terminal": {
      "cols": 90,
      "rows": 26,
      "fontSize": 16,
      "theme": "monokai"
    },
