      "step_id": "s1",
      "title": "Step 1: Setup",
      "code_lines": [
        "import pygame",
        "pygame.init()",
        "screen = pygame.display.set_mode((300, 300))"
      ],
      "language": "python",
      "explanation": "We start by initializing Pygame and creating a 300x300 window for our grid.",
      "duration_s": 6,
      "highlight_lines": [
        0,
        1
      ]
    },
    {
      "step_id": "s2",
      "title": "Step 2: Create the Grid",
      "code_lines": [
        "grid = [[0 for _ in range(10)] for _ in range(10)]"
      ],
      "language": "python",
      "explanation": "We create a 10x10 grid of zeros to represent empty cells.",
      "duration_s": 5,
      "highlight_lines": [
        0
      ]
    },
    {
      "step_id": "s3",
      "title": "Step 3: Handle Events",
      "code_lines": [
        "running = True",
        "while running:",
        "    for event in pygame.event.get():",
        "        if event.type == pygame.QUIT:",
        "            running = False",
        "        if event.type == pygame.MOUSEBUTTONDOWN:",
        "            x, y = pygame.mouse.get_pos()",
        "            grid[y//30][x//30] = 1"
      ],
      "language": "python",
      "explanation": "This loop checks for mouse clicks and updates the grid when a cell is clicked.",
      "duration_s": 8,
      "highlight_lines": [
        5,
        7
      ]
    },
    {
      "step_id": "s4",
      "title": "Step 4: Draw the Grid",
      "code_lines": [
        "screen.fill((255, 255, 255))",
        "for i in range(10):",
        "    for j in range(10):",
        "        if grid[i][j]:",
        "            pygame.draw.rect(screen, (0, 0, 255), (j*30, i*30, 30, 30))",
        "pygame.display.flip()"
      ],
      "language": "python",
      "explanation": "We draw blue rectangles on the screen based on the grid’s state.",
      "duration_s": 7,
      "highlight_lines": [
        3,
        4
      ]
    },
    {
      "step_id": "s5",
      "title": "Step 5: Clean Up",
      "code_lines": [
        "pygame.quit()"
      ],
      "language": "python",
      "explanation": "Finally, we quit Pygame to close the window properly.",
