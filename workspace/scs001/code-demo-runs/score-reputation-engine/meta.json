{
  "script": {
    "version": "1.0",
    "id": "score-reputation-engine",
    "title": "SCORE — Agent Reputation & Trust Scoring",
    "description": "Demonstrates the SCORE protocol: creating a scoring rubric, evaluating agent task performance, building a reputation over time, and auditing decisions. The trust layer that enables agents to select the best collaborators.",
    "scenes": [
      {
        "type": "clear"
      },
      {
        "type": "comment",
        "text": "Scene 1: Create a scoring rubric"
      },
      {
        "type": "output",
        "text": "$ node --input-type=module",
        "caption": "SCORE Protocol — reputation engine demo"
      },
      {
        "type": "pause",
        "durationMs": 600
      },
      {
        "type": "type",
        "text": "import { createRubric, evaluate, calculateReputation } from '@godman-protocols/score';",
        "keystrokeDelayMs": 22,
        "caption": "Import SCORE from npm"
      },
      {
        "type": "pause",
        "durationMs": 800
      },
      {
        "type": "clear"
      },
      {
        "type": "output",
        "text": "// Step 1: Define what 'good' looks like for a coding agent",
        "caption": "Define scoring rubric"
      },
      {
        "type": "pause",
        "durationMs": 500
      },
      {
        "type": "type",
        "text": "const rubric = createRubric({",
        "keystrokeDelayMs": 40
      },
      {
        "type": "type",
        "text": "  id: 'code-quality',",
        "keystrokeDelayMs": 35
      },
      {
        "type": "type",
        "text": "  dimensions: [",
        "keystrokeDelayMs": 35
      },
      {
        "type": "type",
        "text": "    { name: 'correctness', weight: 0.40 },",
        "keystrokeDelayMs": 28
      },
      {
        "type": "type",
        "text": "    { name: 'test-coverage', weight: 0.30 },",
        "keystrokeDelayMs": 28
      },
      {
        "type": "type",
        "text": "    { name: 'code-style',   weight: 0.20 },",
        "keystrokeDelayMs": 28
      },
      {
        "type": "type",
        "text": "    { name: 'latency',      weight: 0.10 }",
        "keystrokeDelayMs": 28
      },
      {
        "type": "type",
        "text": "  ]",
        "keystrokeDelayMs": 35
      },
      {
        "type": "type",
        "text": "});",
        "keystrokeDelayMs": 40
      },
      {
        "type": "pause",
        "durationMs": 900
      },
      {
        "type": "output",
        "text": "",
        "caption": "Rubric created — 4 weighted dimensions"
      },
      {
        "type": "output",
        "text": "rubric.id     → code-quality"
      },
      {
        "type": "output",
        "text": "rubric.weights → correctness:40%  coverage:30%  style:20%  latency:10%"
      },
      {
        "type": "pause",
        "durationMs": 1200
      },
      {
        "type": "clear"
      },
      {
        "type": "comment",
        "text": "Scene 2: Evaluate multiple task completions"
      },
      {
        "type": "output",
        "text": "// Step 2: Score completed tasks — builds reputation over time",
        "caption": "Evaluate task performance"
      },
      {
        "type": "pause",
        "durationMs": 500
      },
      {
        "type": "type",
        "text": "evaluate('coder-agent-1', rubric, { correctness: 95, 'test-coverage': 88, 'code-style': 90, latency: 82 });",
        "keystrokeDelayMs": 18
      },
      {
        "type": "pause",
        "durationMs": 700
      },
      {
        "type": "output",
        "text": "→ SCORE  coder-agent-1  task#1  composite=91.0"
      },
      {
        "type": "pause",
        "durationMs": 500
      },
      {
        "type": "type",
        "text": "evaluate('coder-agent-1', rubric, { correctness: 78, 'test-coverage': 65, 'code-style': 85, latency: 90 });",
        "keystrokeDelayMs": 18
      },
      {
        "type": "pause",
        "durationMs": 700
      },
      {
        "type": "output",
        "text": "→ SCORE  coder-agent-1  task#2  composite=76.5"
      },
      {
        "type": "pause",
        "durationMs": 500
      },
      {
        "type": "type",
        "text": "evaluate('coder-agent-1', rubric, { correctness: 92, 'test-coverage': 91, 'code-style': 88, latency: 95 });",
        "keystrokeDelayMs": 18
      },
      {
        "type": "pause",
        "durationMs": 700
      },
      {
        "type": "output",
        "text": "→ SCORE  coder-agent-1  task#3  composite=91.2"
      },
      {
        "type": "pause",
        "durationMs": 1200
      },
      {
        "type": "clear"
      },
      {
        "type": "comment",
        "text": "Scene 3: Calculate reputation"
      },
      {
        "type": "output",
        "text": "// Step 3: Build reputation from task history — trust score over time",
        "caption": "Reputation built from history"
      },
      {
        "type": "pause",
        "durationMs": 500
      },
      {
        "type": "type",
        "text": "const rep = calculateReputation('coder-agent-1', { windowTasks: 10, decayFactor: 0.9 });",
        "keystrokeDelayMs": 22
      },
      {
        "type": "pause",
        "durationMs": 900
      },
      {
        "type": "output",
        "text": "",
        "caption": "Reputation: exponentially weighted moving average"
      },
      {
        "type": "output",
        "text": "rep.agentId     → coder-agent-1"
      },
      {
        "type": "output",
        "text": "rep.score       → 86.4   (weighted avg of 3 tasks)"
      },
      {
        "type": "output",
        "text": "rep.tier        → 'trusted'  (≥80)"
      },
      {
        "type": "output",
        "text": "rep.taskCount   → 3"
      },
      {
        "type": "output",
        "text": "rep.trend       → +4.2  (improving)"
      },
      {
        "type": "pause",
        "durationMs": 1200
      },
      {
        "type": "clear"
      },
      {
        "type": "comment",
        "text": "Scene 4: Audit trail"
      },
      {
        "type": "output",
        "text": "// Step 4: Immutable audit trail — every score decision logged",
        "caption": "Audit trail for accountability"
      },
      {
        "type": "pause",
        "durationMs": 500
      },
      {
        "type": "type",
        "text": "import { createAuditEntry, getAuditLog } from '@godman-protocols/score';",
        "keystrokeDelayMs": 22
      },
      {
        "type": "pause",
