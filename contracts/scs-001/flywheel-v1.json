{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Content Flywheel — Agent 10 Contract",
  "description": "When Analytics detects viral content (completion >= 70%), generates 4 derivative video briefs for compounding.",
  "version": "1.0.0",
  "status": "LOCKED",
  "locked_date": "2026-03-16",

  "definitions": {
    "FlywheelDerivative": {
      "type": "object",
      "required": ["derivative_id", "source_signal_id", "source_video_id", "variation_type", "suggested_topic", "suggested_hook_formula", "suggested_speaker", "rationale"],
      "properties": {
        "derivative_id": { "type": "string" },
        "source_signal_id": { "type": "string" },
        "source_video_id": { "type": "string" },
        "variation_type": {
          "type": "string",
          "enum": ["different_hook", "different_topic", "different_speaker", "deeper_dive"]
        },
        "suggested_topic": { "type": "string" },
        "suggested_hook_formula": { "type": "string" },
        "suggested_speaker": { "type": "string" },
        "suggested_slot": { "type": "string" },
        "rationale": { "type": "string" }
      }
    },
    "FlywheelOutput": {
      "type": "object",
      "required": ["flywheel_id", "source_signal_id", "source_video_id", "derivatives", "created_at"],
      "properties": {
        "flywheel_id": { "type": "string" },
        "source_signal_id": { "type": "string" },
        "source_video_id": { "type": "string" },
        "derivatives": {
          "type": "array",
          "items": { "$ref": "#/definitions/FlywheelDerivative" },
          "minItems": 4,
          "maxItems": 4
        },
        "created_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
